# Auth.js secret — generar uno propio con: openssl rand -base64 32
AUTH_SECRET=""

# Supabase Postgres.
#
# DATABASE_URL: lo que usa la app en runtime. Es el "Transaction pooler"
# (puerto 6543) de Supabase, que es el que aguanta las funciones serverless
# de Vercel. Necesita ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# DIRECT_URL: conexión directa (puerto 5432). Solo la usan las migraciones y
# los scripts (prisma migrate / seed / import), nunca la app en Vercel.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
